# --- Configuración del Backend ---
PORT=3000
NODE_ENV=production

# Cadena de conexión PostgreSQL (Supabase Pooler)
DATABASE_URL=postgresql://usuario:password@aws-0-region.pooler.supabase.com:5432/postgres

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET=reemplazar_por_clave_secreta_segura

# --- Configuración del Frontend ---
VITE_API_BASE_URL=http://localhost:3000/api/